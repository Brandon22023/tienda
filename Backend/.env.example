APP_NAME=Electrocore
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=error

# PostgreSQL provider (Supabase or another managed PostgreSQL instance).
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Comma-separated browser origins. Add the real Vercel URL when available.
CORS_ALLOWED_ORIGINS=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Keep false in production. Set true only for an intentional first data load.
SEED_ON_STARTUP=false
